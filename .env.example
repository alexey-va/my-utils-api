# Copy to .env and fill in (never commit .env)
MYUTILS_ENV=development
# Production must set a unique secret of at least 32 bytes.
MYUTILS_JWT_SECRET=change-me-in-production-use-long-random-string-at-least-32-chars
MYUTILS_JWT_EXPIRATION_HOURS=24

# Bot starts only when MYUTILS_TELEGRAM_ENABLED=true (the production overlay enables it; keep false locally).
MYUTILS_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Your numeric id from @userinfobot
TELEGRAM_ALLOWED_USER_IDS=
# Optional override for POST /api/telegram/files; otherwise derived from TELEGRAM_BOT_TOKEN
TELEGRAM_FILE_UPLOAD_TOKEN=
OPENROUTER_API_KEY=

# Base64-encoded 32-byte key used only to encrypt recoverable WireGuard client keys.
# Generate with: openssl rand -base64 32
WIREGUARD_CREDENTIALS_ENCRYPTION_KEY=

# OpenRouter via HTTP proxy (optional)
OPENROUTER_PROXY_ENABLED=false
OPENROUTER_PROXY_HOST=
OPENROUTER_PROXY_PORT=8888

# Temporal infrastructure is available locally, but the worker also needs the Telegram/OpenRouter settings above.
# For host `go run`, enable it explicitly and keep the loopback target below.
MYUTILS_TEMPORAL_ENABLED=false
TEMPORAL_TARGET=127.0.0.1:7233
# Вечернее напоминание и модель — в runtime settings: PUT /api/admin/settings/{key}
