WIREGUARD_API_BASE_URL=http://127.0.0.1:8080
WIREGUARD_RELAY_ID=replace-with-relay-uuid
WIREGUARD_AGENT_TOKEN=replace-with-one-time-agent-token
WIREGUARD_INTERFACE=wg-users
WIREGUARD_PUBLIC_ENDPOINT=replace-with-public-host:51820
# Optional route metrics overrides:
# WIREGUARD_AWG_INTERFACE=awg-exit
# WIREGUARD_DIRECT_INTERFACE=eth0
# WIREGUARD_DIRECT_PROBE_TARGETS=77.88.8.1,1.1.1.1,8.8.8.8
# Legacy single-target override remains supported:
# WIREGUARD_DIRECT_PROBE_TARGET=77.88.8.1
