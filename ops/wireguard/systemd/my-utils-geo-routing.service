[Unit]
Description=RU-direct policy routing for my-utils WireGuard clients
After=systemd-networkd.service network-online.target wg-quick@wg-users.service my-utils-wireguard-routing.service
Requires=wg-quick@wg-users.service my-utils-wireguard-routing.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=GEO_ROUTING_ENV_FILE=/etc/my-utils/geo-routing.env
ExecStart=/usr/local/libexec/my-utils-geo-routing start
ExecStop=/usr/local/libexec/my-utils-geo-routing stop

[Install]
WantedBy=multi-user.target
