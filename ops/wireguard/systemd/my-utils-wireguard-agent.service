[Unit]
Description=Converge my-utils WireGuard peers and report heartbeat
After=network-online.target wg-quick@wg-users.service my-utils-wireguard-routing.service
Wants=network-online.target
Requires=wg-quick@wg-users.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/my-utils-wireguard-agent
User=root
Group=root
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run /var/lib/my-utils-wireguard
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
