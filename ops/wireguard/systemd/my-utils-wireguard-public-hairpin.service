[Unit]
Description=Route VPN requests to the relay public address through its existing exit
Requires=my-utils-wireguard-routing.service
After=my-utils-wireguard-routing.service my-utils-geo-routing.service
PartOf=my-utils-wireguard-routing.service
Before=my-utils-wireguard-agent.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/my-utils/wireguard-routing-ha.env
EnvironmentFile=/etc/my-utils/wireguard-public-hairpin.env
ExecStart=/usr/local/libexec/my-utils-wireguard-public-hairpin start
ExecStop=/usr/local/libexec/my-utils-wireguard-public-hairpin stop

[Install]
WantedBy=multi-user.target
